# ============================================================
# Facilitador de Anúncios — variáveis de ambiente do backend
# Copie para server/.env e ajuste. Tudo é opcional em dev.
# NUNCA versione o arquivo .env real (já está no .gitignore).
# ============================================================

# --- Integração Meta (BYOT — Bring Your Own Token) ---
# Versão da Graph API usada pelo MetaAdsService
META_API_VERSION=v23.0

# Variável TEMPORÁRIA exclusiva para a importação inicial da credencial do admin.
# Fluxo: defina aqui → rode `node scripts/import-admin-token.mjs` → REMOVA o valor.
# O token é criptografado (AES-256-GCM) antes de ir para o banco; nunca vai para o código.
META_ADMIN_INITIAL_ACCESS_TOKEN=

# Chave de criptografia (AES-256-GCM) para Access Tokens e App Secrets.
# 64 caracteres hex. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se vazia em dev, uma chave é gerada e salva em server/data/.encryption-key.
# EM PRODUÇÃO DEFINA SEMPRE UMA CHAVE FIXA — se ela mudar, credenciais salvas ficam ilegíveis.
META_CREDENTIALS_ENCRYPTION_KEY=

# --- Geral ---
NODE_ENV=development
PORT=4000
# URL pública do FRONTEND (usada nos links de confirmação/reset enviados por email)
APP_URL=http://localhost:5173

# --- Segurança geral ---
# Chave AES-256-GCM geral (tokens de email/sessões). Se vazia em dev, gerada automaticamente.
ENCRYPTION_KEY=

# --- Sessão ---
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_DAYS=7

# --- Anti-abuso ---
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=20
RATE_LIMIT_WINDOW_MS=60000
LOGIN_COUNT_WINDOW_MINUTES=15

# --- Tokens de email ---
CONFIRM_TOKEN_HOURS=24
RESET_TOKEN_MINUTES=30

# --- SMTP (emails reais) ---
# Sem SMTP configurado = modo dev: emails no outbox local e link direto na tela.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Facilitador de Anúncios <nao-responder@facilitador.local>"

# --- Caminhos (opcional) ---
# DATABASE_PATH=
# UPLOAD_DIR=
